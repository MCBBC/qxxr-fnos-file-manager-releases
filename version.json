  "changes": [
    {
      "plugin": "online-update",
      "version": "1.0.0",
      "message": "新增设置中的关于页面、GitHub Releases 应用与插件更新、校验安装及应用更新日志；新增手动汇总日志和发布命令，构建不上传。"
    },
    {
      "plugin": "file-view",
      "version": "1.7.19",
      "message": "新增文件夹内部缩略图预览并调整文件夹轮廓；图标网格小、中、大尺寸调整为48、72、96像素；支持拖放到回收站并确认。"
    },
    {
      "plugin": "recycle",
      "version": "1.3.7",
      "message": "侧栏回收站支持拖放，多选文件拖动时显示虚线目标和悬停高亮，松开后弹出删除确认框。"
    },
    {
      "plugin": "wallpaper",
      "version": "1.1.5",
      "message": "接入Scene场景与专属设置侧栏、全局声音和帧率、共享音频频谱；修复场景移除入口、沙箱存储兼容和取消导入误报成功。"
    },
    {
      "plugin": "path-picker",
      "version": "1.1.8",
      "message": "统一路径栏与主界面样式，搜索框改为单层，驱动器列表左对齐并仅悬停或选中时显示背景。"
    },
    {
      "plugin": "file-icons",
      "version": "1.1.5",
      "message": "修复文件夹后层底部轮廓为圆角，与文件夹内容预览保持一致。"
    }
  ]
}
